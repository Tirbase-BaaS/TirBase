# Copy to /etc/tirbase/canary.env and restrict to the service user.
# Do not put the token itself here; point at a root-readable token file.
TIRBASE_CANARY_BASE_URL=https://gateway.example.com
TIRBASE_CANARY_TOKEN_FILE=/run/secrets/tirbase-canary-token
TIRBASE_CANARY_INTERVAL_MS=30000
TIRBASE_CANARY_TIMEOUT_MS=10000
TIRBASE_CANARY_PORT=9101
TIRBASE_CANARY_STATE_FILE=/var/lib/tirbase-canary/state.json
