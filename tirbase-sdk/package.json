{
  "name": "@tirbase/sdk",
  "version": "0.1.0",
  "description": "Apache-2.0 TypeScript SDK wrapper over the AGPL-3.0-only TirBase core WASM",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "workspaces": [
    "wasm"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build --target web --out-dir ../tirbase-sdk/wasm ../tirbase-core --no-default-features --features wasm && node ./scripts/prepare-wasm-package.mjs",
    "build:wasm:test": "wasm-pack build --target nodejs --out-dir ../tirbase-sdk/wasm-test ../tirbase-core --no-default-features --features wasm && node ./scripts/prepare-wasm-test-package.mjs",
    "build:ts": "tsc --project tsconfig.json",
    "build": "npm run build:wasm && npm run build:ts",
    "pretest": "npm run build:wasm && npm run build:wasm:test",
    "test": "jest",
    "test:wasm-e2e": "jest src/__tests__/tirbase-wasm.test.ts src/__tests__/tirbase-manager-ops.wasm.test.ts",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "offline-first",
    "local-first",
    "crdt",
    "sync",
    "mesh",
    "tirbase",
    "wasm"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@tirbase/core-wasm": "0.1.0",
    "eventemitter3": "5.0.4"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "22.15.29",
    "jest": "29.7.0",
    "jest-environment-jsdom": "^30.5.1",
    "ts-jest": "29.4.12",
    "typescript": "5.8.3"
  }
}
