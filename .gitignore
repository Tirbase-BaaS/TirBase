# Generated by Cargo
target/
**/*.rs.bk
*.pdb

# Backup files
*.bak
*.swp
*~

# Editor / IDE
.idea/
.vscode/
*.iml

# OS files
.DS_Store
Thumbs.db

# Local env
.env
.env.local
.freebuff
.kiro
# Node / TypeScript SDK (tirbase-sdk)
node_modules/
**/node_modules/
package-lock.json
**/package-lock.json
tirbase-sdk/wasm-test/
sdk/typescript/dist/

# tirbase-sdk/wasm/ — generated WASM artefact (produced by wasm-pack).
# The build output is ignored, but the @tirbase/core-wasm manifest and its
# ignore file are tracked so a fresh clone can resolve the npm workspace.
tirbase-sdk/wasm/*
!tirbase-sdk/wasm/package.json
!tirbase-sdk/wasm/.gitignore

# Kellnr data directory (Docker volume is external, but in case of local binary mode)
.kellnr/data/

# Python cache
__pycache__/
*.py[cod]

# Local planning documents (not published)
docs/vertical-expansion-plan.local.md
