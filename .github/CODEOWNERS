# Default: every file requires review from a core maintainer.
* @tirbase-maintainers

# Security-sensitive paths require an additional security-team review.
SECURITY.md                     @tirbase-maintainers @tirbase-security
.well-known/security.txt        @tirbase-maintainers @tirbase-security
LICENSE                         @tirbase-maintainers @tirbase-security
CLAIMS.md                       @tirbase-maintainers @tirbase-security
deny.toml                       @tirbase-maintainers @tirbase-security
audit.toml                      @tirbase-maintainers @tirbase-security

# CI and supply-chain infrastructure requires review from the infra team.
.github/                        @tirbase-maintainers @tirbase-infra
scripts/                        @tirbase-maintainers @tirbase-infra
Cargo.lock                      @tirbase-maintainers @tirbase-infra

# Core library: authentication and CRDT paths.
tirbase-core/src/auth/          @tirbase-maintainers @tirbase-security
tirbase-core/src/crdt/          @tirbase-maintainers
tirbase-core/src/migration/     @tirbase-maintainers

# Guard crate: every change requires security-team sign-off.
tirbase-guard/                  @tirbase-maintainers @tirbase-security

# Documentation.
docs/                           @tirbase-maintainers
CONTRIBUTING.md                 @tirbase-maintainers
README.md                       @tirbase-maintainers
