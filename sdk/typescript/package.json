{
  "name": "@tirbase/gateway-admin-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK generated from TirBase gateway admin OpenAPI 3.1 definition (CLAIM-49.1/49.2).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mtls": {
      "types": "./dist/mtls.d.ts",
      "default": "./dist/mtls.js"
    }
  },
  "files": [
    "dist/",
    "src/",
    "openapi.yaml"
  ],
  "scripts": {
    "generate": "node ../../scripts/generate-gateway-sdk.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "@types/node": "22.15.29",
    "typescript": "5.8.3"
  }
}
